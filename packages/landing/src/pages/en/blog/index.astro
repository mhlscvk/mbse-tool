---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const posts = (await getCollection('blog-en', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<PageLayout
  title="Blog — System2Product"
  description="The System2Product blog: writing on model-to-product engineering."
  lang={lang}
  pageKey="blog"
>
  <section class="section">
    <div class="container">
      <h1>{t('blog.title')}</h1>
      {
        posts.length === 0 ? (
          <p class="muted" style="margin-top: var(--space-4)">{t('blog.empty')}</p>
        ) : (
          <div class="grid grid-3" style="margin-top: var(--space-5)">
            {posts.map((post) => (
              <BlogCard
                lang={lang}
                slug={post.slug}
                title={post.data.title}
                description={post.data.description}
                publishedAt={post.data.publishedAt}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</PageLayout>
