---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang, PageKey } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pageKey?: PageKey;
  ogImage?: string;
}

const { title, description, lang, pageKey, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} pageKey={pageKey} ogImage={ogImage}>
  <Header lang={lang} pageKey={pageKey} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</BaseLayout>
