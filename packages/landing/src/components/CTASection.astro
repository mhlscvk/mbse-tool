---
interface Props {
  title: string;
  text?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Optional "or email us directly" line shown below the buttons. */
  emailText?: string;
  /** Email address for the inline link (rendered as mailto:). */
  email?: string;
  /** Optional small reassurance line at the very bottom. */
  note?: string;
}

const {
  title,
  text,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  emailText,
  email,
  note,
} = Astro.props;
---

<section class="section section-dark cta">
  <div class="container">
    <h2>{title}</h2>
    {text && <p class="lead">{text}</p>}
    <div class="cta-actions">
      <a class="btn btn-primary" href={ctaHref}>{ctaLabel}</a>
      {secondaryLabel && secondaryHref && (
        <a class="btn btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
      )}
    </div>
    {
      email && (
        <p class="cta-email">
          {emailText} <a href={`mailto:${email}`}>{email}</a>
        </p>
      )
    }
    {note && <p class="cta-note">{note}</p>}
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }
  .cta .lead {
    margin-inline: auto;
    margin-top: var(--space-3);
    color: var(--text-inverse);
    opacity: 0.85;
  }
  .cta-actions {
    margin-top: var(--space-5);
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-email {
    margin-top: var(--space-4);
    color: var(--text-inverse);
    opacity: 0.85;
    font-size: 0.95rem;
  }
  .cta-note {
    margin-top: var(--space-3);
    color: var(--text-inverse);
    opacity: 0.6;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
</style>
