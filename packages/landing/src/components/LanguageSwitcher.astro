---
import { routeMap, type Lang, type PageKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  pageKey?: PageKey;
}

const { lang, pageKey } = Astro.props;

// Smart resolution: link to the same logical page in the other language.
// Falls back to the home page when the current page has no known key.
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const key: PageKey = pageKey ?? 'home';
const href = routeMap[key][other];
const label = other === 'tr' ? 'Türkçe' : 'English';
---

<a class="lang-switch" href={href} hreflang={other} lang={other}>{label}</a>

<style>
  .lang-switch {
    color: var(--text-inverse);
    border: 1px solid var(--color-amber);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .lang-switch:hover {
    background: var(--color-amber);
    color: var(--color-ink);
  }
</style>
