---
interface Props {
  active?: 'hakkimizda' | 'randevu';
}
const { active } = Astro.props;
---

<nav class="top">
  <div class="nav-inner">
    <a class="brand" href="/">Payanda<span class="lab"> Lab</span></a>
    <div class="nav-right">
      <a class="nav-text-btn" href="/hakkimizda" aria-current={active === 'hakkimizda' ? 'page' : undefined}
        >Hakkımızda</a
      >
      <a class="nav-cta-btn" href="/randevu" aria-current={active === 'randevu' ? 'page' : undefined}
        >Randevu Al</a
      >
    </div>
  </div>
</nav>
