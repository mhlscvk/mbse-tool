// ─── SysML keywords / primitives / namespaces NEVER to translate ────────────
// These keys must be excluded from the map even if accidentally added.
const NEVER_TRANSLATE = new Set([
  // SysML keywords
  'part', 'def', 'attribute', 'port', 'item', 'enum', 'action', 'state',
  'requirement', 'constraint', 'calc', 'package', 'import', 'use', 'case',
  'view', 'viewpoint', 'allocation', 'occurrence', 'individual', 'snapshot',
  'timeslice', 'metadata', 'concern', 'verification', 'analysis', 'rendering',
  'alias', 'comment', 'doc', 'message', 'flow', 'in', 'out', 'inout', 'first',
  'then', 'transition', 'satisfy', 'verify', 'allocate', 'fork', 'join',
  'decide', 'merge', 'if', 'perform', 'exhibit', 'entry', 'do', 'exit', 'send',
  'accept', 'event', 'bind', 'by', 'of', 'from', 'to', 'return', 'interface',
  'connection', 'connect', 'after', 'before', 'at', 'until', 'while', 'for',
  'expose', 'subject', 'actor', 'stakeholder', 'objective', 'render', 'specifies',
  'frame', 'private', 'public', 'protected', 'abstract', 'redefines', 'specializes',
  'subsets', 'feature', 'ref', 'as', 'all', 'is', 'not', 'and', 'or', 'over',
  'specified', 'block', 'assert', 'assign', 'compute', 'iterate', 'loop', 'guard',
  'until', 'about', 'concerned', 'reverses', 'meets',
  // Primitive types
  'Real', 'Integer', 'Boolean', 'String', 'true', 'false', 'null',
  // Standard namespaces
  'ScalarValues', 'ISQ', 'SI', 'USCustomaryUnits', 'Quantities', 'Numerical',
]);

// Defensive: filter out anything that's a keyword.
for (const k of NEVER_TRANSLATE) {
  if (k in IDENT_MAP) delete (IDENT_MAP as Record<string, string>)[k];
}

// ─── Translation logic ──────────────────────────────────────────────────────

function translateContent(content: string): string {
  // Build a single regex matching all identifiers as whole words.
  // Sort keys longer-first so e.g. `BrakeSystem` matches before `Brake`.
  const keys = Object.keys(IDENT_MAP).sort((a, b) => b.length - a.length);
  if (keys.length === 0) return content;
  const escaped = keys.map(k => k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  const re = new RegExp(`\\b(${escaped.join('|')})\\b`, 'g');
  return content.replace(re, (m) => IDENT_MAP[m] || m);
}

function translatePath(name: string, map: Record<string, string>): string {
  return map[name] || name;
}

function processDir(srcDir: string, dstDir: string, depth = 0): { dirs: number; files: number } {
  let dirs = 0;
  let files = 0;
  if (depth > 5) return { dirs, files };
  mkdirSync(dstDir, { recursive: true });

  for (const entry of readdirSync(srcDir, { withFileTypes: true })) {
    const srcPath = join(srcDir, entry.name);
    if (entry.isDirectory()) {
      if (EXCLUDE_DIRS.has(entry.name)) continue;
      const trName = translatePath(entry.name, FOLDER_MAP);
      const dstPath = join(dstDir, trName);
      const sub = processDir(srcPath, dstPath, depth + 1);
      dirs += sub.dirs + 1;
      files += sub.files;
    } else if (entry.isFile() && entry.name.endsWith('.sysml')) {
      const base = basename(entry.name, '.sysml');
      const trBase = translatePath(base, FILE_MAP);
      const dstPath = join(dstDir, `${trBase}.sysml`);
      const content = readFileSync(srcPath, 'utf-8');
      const translated = translateContent(content);
      writeFileSync(dstPath, translated, 'utf-8');
      files++;
    }
  }
  return { dirs, files };
}

// ─── Main ───────────────────────────────────────────────────────────────────

if (!existsSync(SRC)) {
  console.error(`Source directory not found: ${SRC}`);
  process.exit(1);
}

if (existsSync(DST)) {
  console.log(`Removing existing destination: ${DST}`);
  rmSync(DST, { recursive: true });
}

const { dirs, files } = processDir(SRC, DST);
console.log(`Translated ${dirs} directories, ${files} files → ${DST}`);
console.log(`Identifier map entries: ${Object.keys(IDENT_MAP).length}`);
